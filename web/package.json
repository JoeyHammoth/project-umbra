{
  "name": "umbra-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Browser front end for UMBRA, the muon-tomography observatory",
  "license": "MIT",
  "scripts": {
    "dev": "node scripts/build-wasm.mjs && vite",
    "build:wasm": "node scripts/build-wasm.mjs",
    "build": "npm run build:wasm && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test src/compute/bus.test.ts src/compute/handler.test.ts src/compute/cache.test.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^6.3.0",
    "fake-indexeddb": "^6.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
